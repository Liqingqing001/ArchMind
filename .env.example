# Copy to .env; generate different random secrets locally.
# Suggested: python -c "import secrets; print(secrets.token_hex(32))"
POSTGRES_PASSWORD=
ADMIN_TOKEN=
# Optional: read-only Agent retrieval token; do not give the Agent ADMIN_TOKEN.
KNOWLEDGE_TOKEN=
APP_PORT=8000
