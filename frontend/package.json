{
  "name": "knowledge-console",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "build:demo": "node ../scripts/build-demo-data.mjs && tsc -b && vite build --mode demo --base=/ArchMind/",
    "test:demo": "node ../scripts/build-demo-data.mjs && node --experimental-strip-types tests/demo.test.mjs && node --experimental-strip-types tests/browser-model.test.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.4.0",
    "typescript": "~5.8.3",
    "vite": "^6.3.0"
  }
}
